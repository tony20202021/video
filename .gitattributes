# Все текстовые файлы — LF в репозитории, checkout не меняет окончания
* text=auto eol=lf

# Явно: Python, shell, конфиги
*.py    text eol=lf
*.sh    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.env   text eol=lf

# Бинарные — не трогать
*.jpg   binary
*.jpeg  binary
*.png   binary
*.onnx  binary
