# ─── Conda ────────────────────────────────────────────────────────────────────
CONDA_ENV=conda_video

# ─── Telegram Bot ─────────────────────────────────────────────────────────────
# Получить у @BotFather
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram user_id администраторов (через запятую)
# Узнать свой ID: написать @userinfobot
ADMIN_IDS=123456789,987654321

# ─── Backend ──────────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000

# ─── Камеры (пример вымышленный) ──────────────────────────────────────────────
# CAM_<stem>_URL — субпоток (низкое разрешение): motion_watch сравнивает кадры по нему.
# CAM_<stem>_HI_URL — главный поток (высокое разрешение): те же channel/логин, stream=0; куда
#   пишутся baseline / движение / heartbeat. Если не задан — используется тот же URL, что и URL.
# Пример одной склейки, две обрезки U/D:
# CAM_01_9_U_URL=rtsp://192.168.1.101:554/user=demo&password=demo123&channel=0&stream=1.sdp?real_stream
# CAM_01_9_U_HI_URL=rtsp://192.168.1.101:554/user=demo&password=demo123&channel=0&stream=0.sdp?real_stream
# CAM_01_9_D_URL=<как U — один субпоток на обе «камеры»>
# CAM_01_9_D_HI_URL=<как U_HI — один main на обе>
CAM_01_URL=rtsp://192.168.1.101:554/user=demo&password=demo123&channel=1&stream=1.sdp?real_stream
CAM_02_URL=rtsp://198.51.100.10:5541/user=demo&password=demo123&channel=1&stream=1.sdp?real_stream
CAM_03_URL=rtsp://198.51.100.10:5542/user=demo&password=demo123&channel=1&stream=1.sdp?real_stream
CAM_04_URL=rtsp://198.51.100.10:5543/user=demo&password=demo123&channel=1&stream=1.sdp?real_stream

# Подканалы / склейка (stem произвольный: 01_0, 01_9_U, 01_10_D, …):
# CAM_01_9_U_URL=rtsp://192.168.1.101:554/user=demo&password=demo123&channel=0&stream=1.sdp?real_stream
# CAM_01_9_U_CROP_REL=0,0,1,0.5

# ─── Обрезка склеенного кадра (scripts/cameras/motion_watch, verify_cameras): доли x,y,w,h (0…1)
# Глобально, если нет своей CAM_<stem>_CROP_REL:
# MOTION_CROP_REL=0,0,1,0.5
# Верхняя и нижняя половина (горизонтальное деление), доли x,y,w,h:
CAM_01_CROP_REL=0,0,1,0.5
CAM_02_CROP_REL=0,0.5,1,0.5

# ─── scripts/cameras/motion_watch.py ─────────────────────────────────────────
MOTION_DIFF_THRESHOLD=10
# Пульс по умолчанию в скрипте 600; здесь пример переопределения:
MOTION_HEARTBEAT_SEC=600

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB=video_surveillance
