# ─── Conda ────────────────────────────────────────────────────────────────────
CONDA_ENV=conda_video

# ─── Telegram Bot ─────────────────────────────────────────────────────────────
# Получить у @BotFather
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram user_id администраторов (через запятую)
# Узнать свой ID: написать @userinfobot
ADMIN_IDS=123456789,987654321

# ─── Backend ──────────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000

# ─── Камеры ───────────────────────────────────────────────────────────────────
# stream=0 — основной поток (2048×1080), stream=1 — субпоток для анализа
CAM_01_URL=rtsp://192.168.1.101:554/user=admin&password=&channel=1&stream=1.sdp?real_stream
CAM_02_URL=rtsp://<external_ip>:5541/user=admin&password=&channel=1&stream=1.sdp?real_stream
CAM_03_URL=rtsp://<external_ip>:5542/user=admin&password=&channel=1&stream=1.sdp?real_stream
CAM_04_URL=rtsp://<external_ip>:5543/user=admin&password=&channel=1&stream=1.sdp?real_stream

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB=video_surveillance
